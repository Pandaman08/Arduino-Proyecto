# Copia este archivo como .env y completa credenciales de aplicación MQTT.
# No uses credenciales administrativas del panel EMQX.
MQTT_HOST=cafes.duckdns.org
MQTT_PORT=443
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_NODE_ID=secador_01
MQTT_CLIENT_ID_PREFIX=arduino-proyecto
MQTT_STREAMLIT_ENABLED=false

SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
